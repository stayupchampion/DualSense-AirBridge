* text=auto
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
licenses/*.txt text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.cs text eol=lf
*.cc text eol=lf
*.hh text eol=lf
# Unified diff context uses a single space for otherwise empty lines.
*.patch text eol=lf whitespace=-blank-at-eol
*.png binary
*.ico binary
